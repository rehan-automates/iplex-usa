# Public URL of the site, used for canonical links, Open Graph, the sitemap and structured data.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where form submissions are sent (contact, partner applications, scorecard, agency landing page).
# Use a GoHighLevel "Inbound Webhook" workflow trigger, Zapier or Make. Required in production.
LEAD_WEBHOOK_URL=

# Your booking calendar's public booking-page URL (GoHighLevel, Calendly or Cal.com).
# When set, /book embeds it (pre-filled with the visitor's details). Set the calendar's
# "redirect after booking" to https://your-domain/thank-you.
NEXT_PUBLIC_BOOKING_EMBED_URL=

# Optional tracking. Scripts load only when set AND the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
